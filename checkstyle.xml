<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Reglas de la "Guía Spring" (Yachay Wasi) que verifica Checkstyle; el mapa está en la
     "Guía GitHub Actions y calidad de CI", sección 4.2. -->
<module name="Checker">
  <property name="severity" value="warning"/>
  <module name="SuppressionFilter">
    <property name="file" value="${checkstyle.suppressions.file}"/>
  </module>
  <!-- BE-SPR-COD-09 -->
  <module name="FileLength">
    <property name="max" value="800"/>
  </module>
  <module name="TreeWalker">
    <!-- BE-SPR-COD-09 -->
    <module name="MethodLength">
      <property name="max" value="50"/>
    </module>
    <module name="NestedIfDepth">
      <property name="max" value="4"/>
    </module>
    <module name="NestedTryDepth">
      <property name="max" value="4"/>
    </module>
    <!-- BE-SPR-DI-05 -->
    <module name="ParameterNumber">
      <property name="max" value="7"/>
    </module>
    <!-- BE-SPR-COD-02 -->
    <module name="IllegalImport">
      <property name="illegalPkgs" value="lombok"/>
    </module>
    <!-- BE-SPR-COD-05 -->
    <module name="IllegalCatch">
      <property name="illegalClassNames" value="Exception, Throwable, RuntimeException"/>
    </module>
    <!-- BE-SPR-COD-10 -->
    <module name="TodoComment">
      <property name="format" value="(TODO|FIXME)(?!\([A-Z][A-Z0-9]*-[0-9]+\))"/>
    </module>
    <!-- BE-SPR-EST-02 -->
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="MemberName"/>
    <module name="ParameterName"/>
    <module name="LocalVariableName"/>
    <module name="ConstantName"/>
    <module name="PackageName"/>
    <!-- BE-SPR-EST-06 -->
    <module name="OneTopLevelClass"/>
    <!-- BE-SPR-EST-03: solo en port/in (ver checkstyle-suppressions.xml) -->
    <module name="MissingJavadocType">
      <property name="scope" value="public"/>
    </module>
    <module name="MissingJavadocMethod">
      <property name="scope" value="public"/>
    </module>
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
  </module>
</module>
